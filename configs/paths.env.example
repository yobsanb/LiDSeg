# LiDSeg path configuration.
#
#   cp configs/paths.env.example configs/paths.env
#   # then edit the roots below to point at your copies of the datasets
#
# configs/paths.env is git-ignored: it holds machine-specific absolute paths.
# None of the datasets are redistributed with this repository — see the
# "Datasets" section of README.md for where to obtain each one and under what
# licence.

# ---------------------------------------------------------------------------
# Datasets
# ---------------------------------------------------------------------------

# Cityscapes and Foggy Cityscapes share one root.  Expected layout:
#
#   $CITYSCAPES_ROOT/
#     leftImg8bit/{train,val}/<city>/*_leftImg8bit.png      clear images
#     gtFine/{train,val}/<city>/*_gtFine_labelTrainIds.png  labels
#     foggy_0.00/leftImg8bit/{train,val}/<city>/*.png       clear reference
#     Foggy_0.005/leftImg8bit/{train,val}/<city>/*.png      light fog
#     Foggy_0.01/leftImg8bit/{train,val}/<city>/*.png       medium fog
#     Foggy_0.02/leftImg8bit/{train,val}/<city>/*.png       dense fog
#
# The Foggy_* directories come from the Foggy Cityscapes release; foggy_0.00 is
# the clear reference used as the reconstruction target during pretraining.
CITYSCAPES_ROOT=/path/to/datasets/cityscapes

# Clear-Cityscapes root for the validate-only Stage 0 anchor.  Set it to the
# same value as CITYSCAPES_ROOT unless you keep a separate clear-only copy.
CITYSCAPES_CLEAR_ROOT=/path/to/datasets/cityscapes

# ACDC. Expected layout:
#
#   $ACDC_ROOT/
#     rgb_anon/<fog|night|rain|snow>/{train,val,test}/<scene>/*_rgb_anon.png
#     gt/<fog|night|rain|snow>/{train,val}/<scene>/*_gt_labelTrainIds.png
ACDC_ROOT=/path/to/datasets/ACDC

# Zero-shot evaluation only (optional; leave blank to skip).
FOGGY_DRIVING_ROOT=/path/to/datasets/Foggy_Driving
FOGGY_ZURICH_ROOT=/path/to/datasets/Foggy_Zurich

# ---------------------------------------------------------------------------
# Repository and outputs
# ---------------------------------------------------------------------------
LIDSEG_REPO=/path/to/LiDSeg
LIDSEG_OUTPUT=/path/to/LiDSeg/output
